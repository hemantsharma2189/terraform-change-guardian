{
  "format_version": "1.2",
  "terraform_version": "1.7.0",
  "resource_changes": [
    {
      "address": "aws_security_group.public_web",
      "type": "aws_security_group",
      "change": {
        "actions": ["create"],
        "after": {
          "name": "public-web",
          "ingress": [
            {
              "from_port": 22,
              "to_port": 22,
              "protocol": "tcp",
              "cidr_blocks": ["0.0.0.0/0"]
            }
          ],
          "tags": {}
        }
      }
    },
    {
      "address": "aws_s3_bucket.temporary_data",
      "type": "aws_s3_bucket",
      "change": {
        "actions": ["delete"],
        "after": null
      }
    },
    {
      "address": "aws_ebs_volume.application_data",
      "type": "aws_ebs_volume",
      "change": {
        "actions": ["create"],
        "after": {
          "encrypted": false,
          "size": 20,
          "tags": {
            "Environment": "test"
          }
        }
      }
    },
    {
      "address": "aws_iam_policy.admin_policy",
      "type": "aws_iam_policy",
      "change": {
        "actions": ["create"],
        "after": {
          "name": "admin-policy",
          "policy": {
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "*",
                "Resource": "*"
              }
            ]
          },
          "tags": {}
        }
      }
    }
  ]
}
